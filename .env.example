# Copy this file to .env.local and fill in real keys.
# .env.local is gitignored; .env.example is committed as a template.
# Never put real secrets in this file.

# OpenAI: chat (gpt-4o) AND every auditor call (extractor, 3 verifier subagents,
# dehallucinator) — all use gpt-4o-mini. Get a key at:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini: chat only (gemini-2.5-flash). Never used by
# the auditor — keeping the auditor fixed to OpenAI is what makes the
# chat-model comparison meaningful. Get a key at:
# https://aistudio.google.com/apikey
# NOTE: this is a Google API key, NOT an OAuth client ID URL.
GEMINI_API_KEY=

# Anthropic Claude: chat only (claude-haiku-4-5). Never used by the auditor
# — same locked-auditor rule as Gemini. Wired in as the third chat provider
# for the IMPROVEMENTS.md Phase B eval comparison. Get a key at:
# https://console.anthropic.com/settings/keys
# NOTE: Anthropic has no perpetual free API tier; new accounts get a one-
# time trial credit. Haiku is the cheapest model + most generous rate
# limits, which is why we hardcoded it (mirrors the Gemini Flash choice).
ANTHROPIC_API_KEY=

# Tavily: web search for evidence retrieval inside each verifier subagent.
# Free tier is plenty for development. Get a key at:
# https://tavily.com
TAVILY_API_KEY=

# ── Connectors (MAJOR_CHANGES.md #C1 — Notion source connector) ──────────────
# The /workspace feature lets users connect Notion (via its hosted MCP server)
# and audit AI output against a trusted Notion page. These are only needed if
# you use that page; the rest of the app runs without them.

# Public base URL of THIS app. Used to build the OAuth redirect URI
# (<APP_BASE_URL>/api/connectors/notion/callback). Must exactly match the URL
# the browser hits. Defaults to the request origin if unset (fine for local).
APP_BASE_URL=http://localhost:3000

# Encryption key for the on-disk OAuth token store (.connector-data/). This is
# the ONE place the app persists state — deliberately, per MAJOR_CHANGES.md #C1.
# Use a long random string. If unset, an insecure dev fallback is used + warned.
TOKEN_ENC_KEY=

# Optional override of Notion's hosted MCP base URL. Leave blank to use the
# default (https://mcp.notion.com). Notion's MCP supports dynamic client
# registration, so NO manual Notion integration / client id is required.
NOTION_MCP_URL=

# ── Google connectors: Drive/Docs + Gmail (MAJOR_CHANGES.md #C1) ─────────────
# Google has no hosted MCP server, so these connectors use Google's REST APIs
# directly via ONE Google Cloud OAuth app (shared by both Drive and Gmail).
# Only needed for the Google Drive / Gmail sources in /workspace. Setup:
#   1. Google Cloud Console → create/select a project.
#   2. APIs & Services → enable BOTH "Google Drive API" and "Gmail API".
#   3. OAuth consent screen (Google Auth Platform) → External; add scopes
#      ".../auth/drive.readonly" and ".../auth/gmail.readonly"; add your
#      account under Audience → Test users.
#   4. Credentials → Create OAuth client ID → Web application. Add BOTH
#      authorized redirect URIs (same app powers both connectors):
#        <APP_BASE_URL>/api/connectors/google/callback
#        <APP_BASE_URL>/api/connectors/gmail/callback
#      (e.g. http://localhost:3000/api/connectors/google/callback)
#   5. Paste the client id + secret below. Drive and Gmail connect separately
#      in the UI (each gets its own consent + token), but share these creds.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Slack connector (MAJOR_CHANGES.md #C1) ───────────────────────────────────
# Slack has no hosted MCP server, so this connector uses the Slack Web API
# directly over OAuth v2 (no PKCE). Only needed for the Slack source in
# /workspace. Setup:
#   1. https://api.slack.com/apps → Create New App → From scratch → pick a
#      workspace.
#   2. OAuth & Permissions → Redirect URLs → add:
#        <APP_BASE_URL>/api/connectors/slack/callback
#        (e.g. http://localhost:3000/api/connectors/slack/callback)
#   3. OAuth & Permissions → "User Token Scopes" (NOT bot scopes) → add:
#        search:read, channels:history, groups:history, channels:read,
#        groups:read, users:read
#   4. Install the app to your workspace (you can install your own app in dev
#      without admin approval).
#   5. Basic Information → App Credentials → copy the Client ID + Client Secret.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
